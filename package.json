{
  "name": "giri256-profile",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node scripts/build.mjs",
    "hero": "remotion render banners/index.ts Hero out/hero.mp4 --props=data/hero-props.json --crf=12",
    "upstream": "remotion render banners/index.ts Upstream out/upstream.mp4 --props=data/upstream-props.json --crf=12",
    "banners": "npm run -s hero && npm run -s upstream && node scripts/webp.mjs hero upstream",
    "studio": "remotion studio banners/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
